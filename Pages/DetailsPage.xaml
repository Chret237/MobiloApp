<?xml version="1.0" encoding="utf-8" ?>
<c:MobiloPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:MobiloApp.Controls"
              x:Class="MobiloApp.Pages.DetailsPage"
              BackgroundColor="White">
	<Grid RowDefinitions="*,Auto">
		<ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
			<VerticalStackLayout Spacing="0">

				<!-- hero photo -->
				<Grid x:Name="Hero" HeightRequest="340">
					<Image x:Name="HeroImage" Aspect="AspectFill" />
					<BoxView>
						<BoxView.Background>
							<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
								<GradientStop Color="#5905140F" Offset="0" />
								<GradientStop Color="#0005140F" Offset="0.35" />
							</LinearGradientBrush>
						</BoxView.Background>
					</BoxView>
					<Grid ColumnDefinitions="*,Auto" Margin="20,22,20,0" VerticalOptions="Start">
						<c:IconButton Icon="back" HorizontalOptions="Start" Clicked="OnBack" />
						<c:IconButton Grid.Column="1" Icon="heart" />
					</Grid>
					<Border HorizontalOptions="End" VerticalOptions="End" Margin="0,0,18,16" Padding="10,7"
					        BackgroundColor="#B80B1E18" StrokeThickness="0" StrokeShape="RoundRectangle 999">
						<Label Text="1 / 6" FontSize="10" TextColor="White" />
					</Border>
				</Grid>

				<VerticalStackLayout Padding="22" Spacing="0">
					<Grid ColumnDefinitions="*,Auto">
						<VerticalStackLayout Spacing="0">
							<c:Badge Text="Top rated" Mint="True" Margin="0,0,0,9" />
							<Label Text="Range Rover Velar" FontFamily="ManropeBold" FontSize="27" CharacterSpacing="-1.2" />
							<Label Text="Luxury SUV · Automatic" FontSize="12" TextColor="{StaticResource InkSoft}" Margin="0,4,0,0" />
						</VerticalStackLayout>
						<c:RatingView Grid.Column="1" Value="4.9" Count="128" VerticalOptions="Start" />
					</Grid>

					<!-- feature grid -->
					<VerticalStackLayout Margin="0,22" Spacing="18">
						<BoxView HeightRequest="1" Color="{StaticResource Line}" />
						<Grid ColumnDefinitions="*,1,*,1,*,1,*">
							<VerticalStackLayout Spacing="4" HorizontalOptions="Center">
								<c:IconView Icon="user" />
								<Label Text="5" FontFamily="DMSansBold" FontSize="12" HorizontalOptions="Center" />
								<Label Text="Seats" FontSize="9" TextColor="{StaticResource InkSoft}" HorizontalOptions="Center" />
							</VerticalStackLayout>
							<BoxView Grid.Column="1" WidthRequest="1" Color="{StaticResource Line}" />
							<VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
								<c:IconView Icon="car" />
								<Label Text="2" FontFamily="DMSansBold" FontSize="12" HorizontalOptions="Center" />
								<Label Text="Bags" FontSize="9" TextColor="{StaticResource InkSoft}" HorizontalOptions="Center" />
							</VerticalStackLayout>
							<BoxView Grid.Column="3" WidthRequest="1" Color="{StaticResource Line}" />
							<VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
								<c:IconView Icon="menu" />
								<Label Text="Auto" FontFamily="DMSansBold" FontSize="12" HorizontalOptions="Center" />
								<Label Text="Gearbox" FontSize="9" TextColor="{StaticResource InkSoft}" HorizontalOptions="Center" />
							</VerticalStackLayout>
							<BoxView Grid.Column="5" WidthRequest="1" Color="{StaticResource Line}" />
							<VerticalStackLayout Grid.Column="6" Spacing="4" HorizontalOptions="Center">
								<c:IconView Icon="location" />
								<Label Text="4.2 mi" FontFamily="DMSansBold" FontSize="12" HorizontalOptions="Center" />
								<Label Text="Away" FontSize="9" TextColor="{StaticResource InkSoft}" HorizontalOptions="Center" />
							</VerticalStackLayout>
						</Grid>
						<BoxView HeightRequest="1" Color="{StaticResource Line}" />
					</VerticalStackLayout>

					<!-- rental conditions -->
					<Label Text="Rental conditions" FontFamily="ManropeBold" FontSize="21" CharacterSpacing="-0.7" Margin="0,2,0,16" />
					<VerticalStackLayout Spacing="12">
						<Border BackgroundColor="{StaticResource Cream}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
								<c:IconView Icon="shield" />
								<VerticalStackLayout Grid.Column="1" Spacing="3">
									<Label Text="Fully verified" FontFamily="DMSansBold" FontSize="12" />
									<Label Text="Identity and vehicle checks complete" FontSize="10" TextColor="{StaticResource InkSoft}" />
								</VerticalStackLayout>
								<c:IconView Grid.Column="2" Icon="check" Color="#368465" />
							</Grid>
						</Border>
						<Border BackgroundColor="{StaticResource Cream}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
								<c:IconView Icon="clock" />
								<VerticalStackLayout Grid.Column="1" Spacing="3">
									<Label Text="Free cancellation" FontFamily="DMSansBold" FontSize="12" />
									<Label Text="Up to 24 hours before pickup" FontSize="10" TextColor="{StaticResource InkSoft}" />
								</VerticalStackLayout>
								<c:IconView Grid.Column="2" Icon="check" Color="#368465" />
							</Grid>
						</Border>
					</VerticalStackLayout>

					<!-- review -->
					<Border Margin="0,24,0,0" Padding="16" StrokeThickness="1" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18">
						<VerticalStackLayout Spacing="13">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
								<Border WidthRequest="35" HeightRequest="35" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{StaticResource Mint}">
									<Label Text="JM" FontFamily="DMSansBold" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
								</Border>
								<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
									<Label Text="Jamie M." FontFamily="DMSansBold" FontSize="11" />
									<Label Text="Verified renter · 2 weeks ago" FontSize="9" TextColor="{StaticResource InkSoft}" />
								</VerticalStackLayout>
								<c:RatingView Grid.Column="2" Value="5.0" />
							</Grid>
							<Label Text="“Immaculate car and a seamless pickup. Exactly as described.”" FontSize="12"
							       LineHeight="1.4" TextColor="{StaticResource InkSoft}" />
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<!-- sticky booking bar -->
		<VerticalStackLayout Grid.Row="1" BackgroundColor="#F5FFFFFF" Spacing="0">
			<BoxView HeightRequest="1" Color="{StaticResource Line}" />
			<Grid ColumnDefinitions="*,1.2*" ColumnSpacing="20" Padding="22,13,22,18">
				<HorizontalStackLayout Spacing="3" VerticalOptions="Center">
					<Label Text="From" FontSize="10" TextColor="{StaticResource InkSoft}" VerticalOptions="End" Margin="0,0,0,4" />
					<Label Text="$128" FontFamily="ManropeBold" FontSize="22" />
					<Label Text="/ day" FontSize="10" TextColor="{StaticResource InkSoft}" VerticalOptions="End" Margin="0,0,0,4" />
				</HorizontalStackLayout>
				<c:PrimaryButton Grid.Column="1" Text="Book now" Icon="arrow" Clicked="OnBook" />
			</Grid>
		</VerticalStackLayout>
	</Grid>
</c:MobiloPage>
