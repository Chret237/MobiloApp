<?xml version="1.0" encoding="utf-8" ?>
<c:MobiloPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:MobiloApp.Controls"
              x:Class="MobiloApp.Pages.UtilityPage">
	<Grid RowDefinitions="*,Auto">
		<ScrollView Grid.Row="0">
			<VerticalStackLayout>
				<c:AppHeader x:Name="Header" Subtitle="MOBILO" RightIcon="menu" />
				<VerticalStackLayout Padding="22,35" Spacing="10" HorizontalOptions="Fill">
					<Border x:Name="IconCircle" WidthRequest="70" HeightRequest="70" Margin="0,30,0,8" StrokeShape="Ellipse"
					        StrokeThickness="0" BackgroundColor="{StaticResource Mint}" HorizontalOptions="Center">
						<c:IconView x:Name="BigIcon" IconSize="30" Color="{StaticResource Forest}" />
					</Border>
					<Label x:Name="BodyTitle" FontFamily="ManropeBold" FontSize="20" CharacterSpacing="-0.6" HorizontalTextAlignment="Center" />
					<Label x:Name="BodyText" FontSize="13" TextColor="{StaticResource InkSoft}" HorizontalTextAlignment="Center" />

					<Border x:Name="UpcomingCard" Margin="0,15,0,0" Padding="10" StrokeThickness="1" Stroke="{StaticResource Line}"
					        BackgroundColor="White" StrokeShape="RoundRectangle 18">
						<Grid ColumnDefinitions="120,*" ColumnSpacing="13">
							<Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="90">
								<Image x:Name="CarImage" Aspect="AspectFill" />
							</Border>
							<VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
								<c:Badge Text="Confirmed" Mint="True" />
								<Label Text="Range Rover Velar" FontFamily="ManropeBold" FontSize="14" Margin="0,3,0,0" />
								<Label Text="May 16–19 · Austin" FontSize="10" TextColor="{StaticResource InkSoft}" />
							</VerticalStackLayout>
						</Grid>
					</Border>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>
		<c:BottomNav x:Name="BottomBar" Grid.Row="1" />
	</Grid>
</c:MobiloPage>
