<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:MobiloApp.Pages"
       x:Class="MobiloApp.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

	<!-- Every screen of the Figma flow is one route. Navigate with GoToAsync("//route"). -->
	<ShellContent Route="splash"     ContentTemplate="{DataTemplate pages:SplashPage}" />
	<ShellContent Route="onboarding" ContentTemplate="{DataTemplate pages:OnboardingPage}" />
	<ShellContent Route="login"      ContentTemplate="{DataTemplate pages:LoginPage}" />
	<ShellContent Route="register"   ContentTemplate="{DataTemplate pages:RegisterPage}" />
	<ShellContent Route="home"       ContentTemplate="{DataTemplate pages:HomePage}" />
	<ShellContent Route="search"     ContentTemplate="{DataTemplate pages:SearchPage}" />
	<ShellContent Route="server-unavailable" ContentTemplate="{DataTemplate pages:ServerUnavailablePage}" />
	<ShellContent Route="details"    ContentTemplate="{DataTemplate pages:DetailsPage}" />
	<ShellContent Route="booking"    ContentTemplate="{DataTemplate pages:BookingPage}" />
	<ShellContent Route="payment"    ContentTemplate="{DataTemplate pages:PaymentPage}" />
	<ShellContent Route="success"    ContentTemplate="{DataTemplate pages:SuccessPage}" />
	<ShellContent Route="bookings"   ContentTemplate="{DataTemplate pages:BookingsPage}" />
	<ShellContent Route="favorites"  ContentTemplate="{DataTemplate pages:FavoritesPage}" />
	<ShellContent Route="profile"    ContentTemplate="{DataTemplate pages:ProfilePage}" />
</Shell>
